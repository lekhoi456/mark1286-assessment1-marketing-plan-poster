# Source PDFs, course decks and documents are copyrighted and stay local in iCloud only.
# The registry (04_references/references.json) records every file name, URL and hash.
*.pdf
*.ppt
*.pptx
*.doc
*.docx
# Poster outputs (renders, A0 PDFs, speaking-material DOCX) are tracked (student request, 7 October 2026).
!poster/*.pdf
!poster/*.docx
!08_final/*.pdf
!08_final/*.docx
*.mp4
*.zip
*.jpg
*.jpeg
~$*

# Local tooling residue
.DS_Store
__pycache__/
*.pyc
*.json.tmp
/.obsidian/
